{
  "relay": "https://ntfy.sh",
  "secretFile": "./chat.secret",
  "name": "Claude (Pro)",
  "cwd": "./chat-workspace",
  "command": [
    "claude", "-p", "--continue",
    "--output-format", "stream-json", "--verbose",
    "--tools", "",
